import { useState, useEffect } from 'react';
import { supabase } from '../lib/supabase';

export interface Country {
  id: string;
  name: string;
  flag_emoji: string;
  is_recommended: boolean;
}

export interface Package {
  id: string;
  name: string;
  description: string;
  price: number;
}

export interface AdditionalService {
  id: string;
  name: string;
  description: string;
  price: number; // Base price, country-specific price will override
}

export interface Bank {
  id: string;
  name: string;
  price: number;
  flag_url: string;
}

export interface OrderFormData {
  companyName: string;
  companyType: string;
  contactEmail: string;
  phoneNumber: string;
  selectedCountryId: string;
  selectedPackageId: string;
  selectedAdditionalServiceIds: string[];
  selectedBankId: string;
}

const initialFormData: OrderFormData = {
  companyName: '',
  companyType: '',
  contactEmail: '',
  phoneNumber: '',
  selectedCountryId: '',
  selectedPackageId: '',
  selectedAdditionalServiceIds: [],
  selectedBankId: '',
};

export const useOrderForm = () => {
  const [formData, setFormData] = useState<OrderFormData>(initialFormData);
  const [currentStep, setCurrentStep] = useState(1);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [countries, setCountries] = useState<Country[]>([]);
  const [packages, setPackages] = useState<Package[]>([]);
  const [additionalServices, setAdditionalServices] = useState<AdditionalService[]>([]);
  const [banks, setBanks] = useState<Bank[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      setError(null);
      try {
        await Promise.all([
          fetchCountries(),
          fetchPackages(),
          fetchAdditionalServices(),
          fetchBanks(),
        ]);
      } catch (err) {
        console.error('Error fetching initial form data:', err);
        setError('Failed to load form data. Please try again.');
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, []);

  const fetchCountries = async () => {
    const { data, error } = await supabase
      .from('countries')
      .select('id, name, flag_emoji, is_recommended')
      .eq('is_active', true)
      .order('name');
    if (error) throw error;
    setCountries(data || []);
  };

  const fetchPackages = async () => {
    const { data, error } = await supabase
      .from('packages')
      .select('id, name, description, price')
      .eq('is_active', true)
      .order('price');
    if (error) throw error;
    setPackages(data || []);
  };

  const fetchAdditionalServices = async () => {
    const { data, error } = await supabase
      .from('additional_services')
      .select('id, name, description, base_price')
      .eq('is_active', true)
      .order('base_price');
    if (error) throw error;
    setAdditionalServices(data?.map(s => ({ ...s, price: s.base_price })) || []);
  };

  const fetchBanks = async () => {
    const { data, error } = await supabase
      .from('banks')
      .select('id, name, price, flag_url')
      .eq('is_active', true)
      .order('name');
    if (error) throw error;
    setBanks(data || []);
  };

  const updateFormData = (updates: Partial<OrderFormData>) => {
    setFormData(prev => ({ ...prev, ...updates }));
  };

  const nextStep = () => {
    setCurrentStep(prev => prev + 1);
  };

  const prevStep = () => {
    setCurrentStep(prev => prev - 1);
  };

  const submitOrder = async () => {
    setIsSubmitting(true);
    setError(null);
    try {
      // Get client ID from user profile
      const { data: userProfile, error: profileError } = await supabase
        .from('user_profiles')
        .select('id')
        .eq('id', (await supabase.auth.getUser()).data.user?.id)
        .single();

      if (profileError || !userProfile) {
        throw new Error('User profile not found.');
      }

      const { data: clientData, error: clientError } = await supabase
        .from('clients')
        .select('id')
        .eq('profile_id', userProfile.id)
        .single();

      let clientId = clientData?.id;

      if (clientError || !clientId) {
        // If client record doesn't exist, create it
        const { data: newClient, error: newClientError } = await supabase
          .from('clients')
          .insert({
            profile_id: userProfile.id,
            company_name: formData.companyName,
            status: 'pending',
            priority: 'medium',
          })
          .select('id')
          .single();

        if (newClientError || !newClient) {
          throw new Error('Failed to create client record.');
        }
        clientId = newClient.id;
      }

      // Calculate total amount
      const selectedPackage = packages.find(p => p.id === formData.selectedPackageId);
      const selectedBank = banks.find(b => b.id === formData.selectedBankId);
      const selectedAdditionalServicesWithPrices = additionalServices.filter(service =>
        formData.selectedAdditionalServiceIds.includes(service.id)
      ).map(service => {
        const countryService = (additionalServices as any[]).find(cs => cs.id === service.id && cs.countryPrice !== undefined);
        return { ...service, price: countryService ? countryService.countryPrice : service.price };
      });

      let totalAmount = (selectedPackage?.price || 0) + (selectedBank?.price || 0);
      selectedAdditionalServicesWithPrices.forEach(service => {
        totalAmount += service.price;
      });

      // Create service order
      const { data: order, error: orderError } = await supabase
        .from('service_orders')
        .insert({
          client_id: clientId,
          consultant_id: null, // Consultant will be assigned later
          custom_service_id: null, // This is a custom order, not a predefined custom_service
          title: `New Order: ${formData.companyName} - ${selectedPackage?.name}`,
          description: `Company Type: ${formData.companyType}, Email: ${formData.contactEmail}, Phone: ${formData.phoneNumber}, Bank: ${selectedBank?.name}, Additional Services: ${selectedAdditionalServicesWithPrices.map(s => s.name).join(', ')}`,
          total_amount: totalAmount,
          currency: 'USD', // Assuming USD as default currency
          status: 'pending',
          company_name: formData.companyName,
          company_type: formData.companyType,
          selected_package_id: formData.selectedPackageId,
          additional_service_ids: formData.selectedAdditionalServiceIds,
          customer_details: {
            contactEmail: formData.contactEmail,
            phoneNumber: formData.phoneNumber,
          },
          country_id: formData.selectedCountryId,
        })
        .select()
        .single();

      if (orderError) throw orderError;

      alert('Order placed successfully! Your consultant will contact you soon.');
      setFormData(initialFormData); // Reset form
      setCurrentStep(1); // Go back to first step
    } catch (err: any) {
      console.error('Error submitting order:', err);
      setError(err.message || 'Failed to place order. Please try again.');
      alert(err.message || 'Failed to place order. Please try again.');
    } finally {
      setIsSubmitting(false);
    }
  };

  return {
    formData,
    updateFormData,
    currentStep,
    nextStep,
    prevStep,
    isSubmitting,
    submitOrder,
    countries,
    packages,
    additionalServices,
    banks,
    loading,
    error,
  };
};
