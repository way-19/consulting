{
  "name": "consulting19-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/marketing",
    "dev:marketing": "npm run dev --workspace=apps/marketing",
    "dev:client": "npm run dev --workspace=apps/client-dashboard",
    "dev:consultant": "npm run dev --workspace=apps/consultant-dashboard",
    "dev:admin": "npm run dev --workspace=apps/admin-dashboard",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2"
  }
}