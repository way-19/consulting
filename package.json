{
  "name": "consulting19-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:marketing",
    "dev:marketing": "cd apps/marketing && npm run dev",
    "dev:client": "cd apps/client && npm run dev",
    "dev:consultant": "cd apps/consultant && npm run dev",
    "build": "npm run build:client",
    "build:marketing": "cd apps/marketing && npm run build",
    "build:client": "cd apps/client && npm run build",
    "build:consultant": "cd apps/consultant && npm run build",
    "preview": "cd apps/client && npm run preview",
    "lint": "npm run lint:client && npm run lint:consultant",
    "lint:client": "cd apps/client && npm run lint",
    "lint:consultant": "cd apps/consultant && npm run lint"
  },
  "dependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.50.1",
    "invariant": "^2.2.4",
    "lucide-react": "^0.542.0",
    "react-fast-compare": "^3.2.2",
    "shallowequal": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.2.2"
  }
}
